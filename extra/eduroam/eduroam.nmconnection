[connection]
id=eduroam
uuid=f0f04f4b-be94-4ca5-a4fa-525ad3db32d6
type=wifi
permissions=user:adryd:;

[wifi]
ssid=eduroam

[wifi-security]
group=ccmp;
key-mgmt=wpa-eap
pairwise=ccmp;
proto=rsn;

[802-1x]
anonymous-identity=anonymous132416@humber.ca
ca-cert=/home/adryd/.adryd/extra/eduroam/DigiCert_Global_Root_G2.pem.pem
domain-match=circumference.humber.org;diameter.humber.org;mywifi.humber.org;pi.humber.org;wifi-portal.humber.org
eap=peap;
identity=
password-flags=1
phase2-auth=mschapv2

[ipv4]
method=auto

[ipv6]
addr-gen-mode=default
method=auto

[proxy]
