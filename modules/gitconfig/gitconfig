[gpg]
  format = ssh

[gpg "ssh"]
  program = "op-ssh-sign"

[commit]
  gpgsign = true  

[push]
  autosetupremote = true

[init]
  defaultBranch = main

[core]
  excludesfile = ~/.gitignore

[diff]
  algorithm = histogram

[merge]
  tool = meld
  conflictstyle = zdiff3